# 공식 API 키만 쓴다. 실제 .env 는 git 에 올라가지 않는다. (채팅에 키를 붙여넣지 말 것)
# KRX Open API (openapi.krx.co.kr): 인증키 + 서비스별 이용신청
#   유가증권·코스닥 일별매매정보, KOSPI 시리즈 일별시세, ETF 일별매매정보
KRX_API_KEY=
# KIS Developers (apiportal.koreainvestment.com) 실전 앱. 조회 전용
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ENV=prod
# DART OpenAPI (opendart.fss.or.kr), 공시용 (아직 미사용)
DART_API_KEY=
# 데이터는 OneDrive 밖에 둔다 (CSV 수천 개 동기화 방지)
KQ_DATA_DIR=C:\KQuantData
# YouTube Data API v3 (팩트체크 채널·영상 정보). 자막은 yt-dlp 라 키 없음
YOUTUBE_API_KEY=
